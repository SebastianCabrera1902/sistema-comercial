# Base de datos: archivo local en desarrollo, Turso en producción.
DATABASE_URL=file:local.db
# Solo para Turso (libsql://...). Dejar vacío en desarrollo.
DATABASE_AUTH_TOKEN=

# Secreto con el que se firma la cookie de sesión (mínimo 32 caracteres).
# En producción generá uno propio: openssl rand -base64 32
SESSION_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio-123
